{
  "name": "persona-chat",
  "displayName": "Persona.chat",
  "version": "0.1.0",
  "description": "Give your AI a persona. One-click persona switching, world info, and scene backgrounds for DeepSeek and Claude.",
  "author": "punkscosmos.com",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.279",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.20",
    "prettier": "3.4.2",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  },
  "manifest": {
    "host_permissions": [
      "https://chat.deepseek.com/*",
      "https://claude.ai/*",
      "https://chatgpt.com/*"
    ],
    "permissions": [
      "storage",
      "unlimitedStorage",
      "tts"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "sharp"
    ],
    "overrides": {
      "msgpackr": "1.10.2",
      "svelte": "4.2.20",
      "esbuild": "0.25.0",
      "content-security-policy-parser": "0.6.0"
    }
  }
}
